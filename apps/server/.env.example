# Public address of the app, including the /useablepay path
PUBLIC_URL=https://bcafricamusic.tail63a72a.ts.net/useablepay
HOST=127.0.0.1
PORT=3100

# Local Postgres connection
DATABASE_URL=postgres://useablepay:change-me@localhost:5432/useablepay

# Comma-separated emails that get the operator console
ADMIN_EMAILS=you@example.com

# Currency shown to customers and sent to the provider (MTN sandbox only accepts EUR)
APP_CURRENCY=KWD
CURRENCY_DECIMALS=3

# simulator | mtn-momo
PAYMENT_PROVIDER=simulator

# MTN MoMo Collection API (https://momodeveloper.mtn.com)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Set to true once your callback host is registered with MTN
MOMO_SEND_CALLBACK=false
